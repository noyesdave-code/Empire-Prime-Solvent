    "VITE_SUPABASE_URL": "https://lkzxpvleikvvbuhmsgaa.supabase.co",
    "VITE_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_hSVlNSRqpzHDV_QFu5ODIw_fXSmFwbz",
    "VITE_SUPABASE_PROJECT_ID": "lkzxpvleikvvbuhmsgaa",
    "VITE_PAYMENTS_CLIENT_TOKEN": "live_821a1eef30c4b062032f6b6138f"
